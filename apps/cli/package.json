{
  "name": "matelot-cli",
  "version": "2.24.0",
  "description": "Matelot CLI \u2014 deploy, promote, gate, and query the Matelot product-security platform",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bin": {
    "matelot": "dist/index.js",
    "secops": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/matelot-cloud/setup-cli.git"
  },
  "keywords": [
    "security",
    "sbom",
    "cra",
    "devsecops",
    "ci"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "homepage": "https://github.com/matelot-cloud/setup-cli",
  "bugs": {
    "url": "https://github.com/matelot-cloud/matelot/issues"
  }
}
