# Copy to .env for local development (docker compose provides Postgres, Redis and Keycloak).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
REDIS_URL=redis://localhost:6379

# Tokens are validated against this issuer (must match the `iss` claim Keycloak puts in tokens).
KEYCLOAK_ISSUER=http://localhost:8080/realms/platform
# Optional: where the API fetches signing keys. Defaults to <issuer>/protocol/openid-connect/certs.
# In Kubernetes this points at the in-cluster Keycloak service while the issuer stays the public URL.
# KEYCLOAK_JWKS_URI=http://localhost:8080/realms/platform/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=platform-api

# Tenant-cell bootstrap: the root organization is created on startup, and the first login
# of any listed email receives ORG_ADMIN on it. In Kubernetes these come from Helm values.
BOOTSTRAP_ORG_SLUG=acme
BOOTSTRAP_ORG_NAME="ACME Corp"
BOOTSTRAP_ADMIN_EMAILS=admin@acme.local

CORS_ORIGINS=http://localhost:5173

# Public URL of the web app (the GitHub App setup flow returns the browser here).
WEB_BASE_URL=http://localhost:5173

# Encrypts integration credentials at rest. Generate your own: openssl rand -hex 32
CELL_ENCRYPTION_KEY=0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0

# GitHub App (Settings -> Developer settings -> GitHub Apps). Leave empty until you have one;
# the integration reports itself unavailable. Private key as base64: base64 -w0 key.pem
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
# For GitHub Enterprise Server: GITHUB_API_URL=https://ghe.example.com/api/v3 GITHUB_URL=https://ghe.example.com

# Runner image shown in the registration commands. Locally: build it with `make runner-image`.
RUNNER_IMAGE=secops-runner:local

# Built-in container registry (docker compose service "registry"). Run `make registry-keys` once.
REGISTRY_HOST=localhost:5000
REGISTRY_TOKEN_KEY_PATH=deploy/registry/certs/registry.key
REGISTRY_EVENTS_SECRET=change-me-registry-events-secret

# Outbound e-mail for notification channels of kind "email" (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Matelot <no-reply@example.com>
SMTP_SECURE=false

# Built-in registry token realm as seen by registry clients (default http://host.docker.internal:3000/api/v1/registry/token; see SETUP.md for WSL)
# REGISTRY_AUTH_TOKEN_REALM=

# Advisory sources: per-request timeout (ms) for OSV / NVD / EPSS / KEV calls
# ADVISORY_FETCH_TIMEOUT_MS=15000

# Public URL of the API as OAuth issuer / MCP resource (claude.ai connectors, matelot login).
# Also the OIDC issuer for keyless registry connections (GAR/ECR/ACR workload identity federation):
# GCP, AWS and Azure fetch /.well-known/openid-configuration and /.well-known/jwks.json from it,
# so it must be a public HTTPS URL for keyless connections to work.
# Public base of the API as clients reach it (OAuth metadata, registry realm, keyless issuer). Defaults to WEB_BASE_URL;
# set it when the API is reached under another host than the web app.
# API_PUBLIC_URL=https://matelot.example.com

# Rate limits per caller per minute (fixed windows, shared through Redis across API replicas; per process if Redis is down).
# People and personal tokens by user, CI tokens by token, runners by runner, unauthenticated calls by client IP.
# 0 = unlimited for that class. Exempt: health, webhooks, registry token/events, /.well-known.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_READ_PER_MINUTE=1200
# RATE_LIMIT_WRITE_PER_MINUTE=300
# RATE_LIMIT_ANONYMOUS_PER_MINUTE=120
# RATE_LIMIT_RUNNER_PER_MINUTE=1200
# Failed authentication (401) per client IP, every path incl. docker login / webhooks; over it 401 becomes 429.
# RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=30
