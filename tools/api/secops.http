# secops platform API — generated from http://localhost:3000/api/docs-json
# Personal access token: user menu → Access tokens. Fill the ids below (Swagger UI: http://localhost:3000/api/docs).
@baseUrl = http://localhost:3000
@token = spt_REPLACE_ME
@organizationId = 
@workspaceId = 
@teamId = 
@projectId = 
@serviceId = 
@environmentId = 
@repositoryId = 
@integrationId = 
@imageId = 
@sbomId = 
@findingId = 
