{
    "srv0": {
        "listen": [
            ":5000"
        ],
        "routes": [
            {
                "handle": [
                    {
                        "handler": "reverse_proxy",
                        "upstreams": [
                            {
                                "dial": "registry:5000"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "srv1": {
        "listen": [
            ":80"
        ],
        "routes": [
            {
                "handle": [
                    {
                        "encodings": {
                            "gzip": {}
                        },
                        "handler": "encode",
                        "prefer": [
                            "gzip"
                        ]
                    }
                ]
            },
            {
                "group": "group7",
                "handle": [
                    {
                        "handler": "subroute",
                        "routes": [
                            {
                                "handle": [
                                    {
                                        "handler": "reverse_proxy",
                                        "upstreams": [
                                            {
                                                "dial": "api:3000"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "match": [
                    {
                        "path": [
                            "/.well-known/*"
                        ]
                    }
                ]
            },
            {
                "group": "group7",
                "handle": [
                    {
                        "handler": "subroute",
                        "routes": [
                            {
                                "handle": [
                                    {
                                        "handler": "reverse_proxy",
                                        "upstreams": [
                                            {
                                                "dial": "grafana:3000"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "match": [
                    {
                        "path": [
                            "/grafana*"
                        ]
                    }
                ]
            },
            {
                "group": "group7",
                "handle": [
                    {
                        "handler": "subroute",
                        "routes": [
                            {
                                "handle": [
                                    {
                                        "body": "ok",
                                        "handler": "static_response",
                                        "status_code": 200
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "match": [
                    {
                        "path": [
                            "/healthz"
                        ]
                    }
                ]
            },
            {
                "group": "group7",
                "handle": [
                    {
                        "handler": "subroute",
                        "routes": [
                            {
                                "handle": [
                                    {
                                        "handler": "reverse_proxy",
                                        "upstreams": [
                                            {
                                                "dial": "keycloak:8080"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "match": [
                    {
                        "path": [
                            "/auth/*"
                        ]
                    }
                ]
            },
            {
                "group": "group7",
                "handle": [
                    {
                        "handler": "subroute",
                        "routes": [
                            {
                                "handle": [
                                    {
                                        "handler": "reverse_proxy",
                                        "upstreams": [
                                            {
                                                "dial": "api:3000"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "match": [
                    {
                        "path": [
                            "/api/*"
                        ]
                    }
                ]
            },
            {
                "group": "group7",
                "handle": [
                    {
                        "handler": "subroute",
                        "routes": [
                            {
                                "handle": [
                                    {
                                        "handler": "reverse_proxy",
                                        "upstreams": [
                                            {
                                                "dial": "web:8080"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
